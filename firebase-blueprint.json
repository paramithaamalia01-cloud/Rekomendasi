{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document for authenticated staff/admin",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique Firebase Authentication UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "User full name"
        },
        "photoURL": {
          "type": "string",
          "description": "User profile avatar URL"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation ISO timestamp"
        }
      },
      "required": ["userId", "email"]
    },
    "LetterRecord": {
      "title": "LetterRecord",
      "description": "Official letter record generated by the travel agency",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Letter unique ID"
        },
        "userId": {
          "type": "string",
          "description": "UID of the user who generated this letter"
        },
        "namaLengkap": {
          "type": "string",
          "description": "Applicant full name"
        },
        "nik": {
          "type": "string",
          "description": "16-digit NIK of the applicant"
        },
        "nomorKk": {
          "type": "string",
          "description": "16-digit KK number"
        },
        "tempatTanggalLahir": {
          "type": "string",
          "description": "Birth place and birth date"
        },
        "alamatKtp": {
          "type": "string",
          "description": "Full address on KTP"
        },
        "nomorSurat": {
          "type": "string",
          "description": "Official letter number"
        },
        "perihal": {
          "type": "string",
          "description": "Letter subject"
        },
        "templateType": {
          "type": "string",
          "description": "Letter template type"
        },
        "namaPerusahaan": {
          "type": "string",
          "description": "Travel company name"
        },
        "negaraTujuan": {
          "type": "string",
          "description": "Destination country"
        },
        "estimasiKeberangkatan": {
          "type": "string",
          "description": "Schedule/departure date estimation"
        },
        "tanggalSurat": {
          "type": "string",
          "description": "Letter issuance date"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        }
      },
      "required": ["id", "userId", "namaLengkap", "nik", "nomorSurat"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profile records"
    },
    "/letters/{letterId}": {
      "schema": "LetterRecord",
      "description": "Collection of generated travel recommendation and guarantee letters"
    }
  }
}
